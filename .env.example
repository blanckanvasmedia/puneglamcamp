# ==============================================================================
# BK EDU by Minaaz — Pune Glam Camp Vercel Environment Variables
# Add these in Vercel Project Settings -> Environment Variables
# ==============================================================================

# --- GOOGLE SHEETS / GOOGLE APPS SCRIPT CONFIGURATION ---
# Web App URL generated after deploying your Google Apps Script for Pune Glam Camp
# Example: https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec"

# Shared secret string used to authenticate server-side requests to Google Apps Script
GOOGLE_SHEETS_INGEST_SECRET="YourServerSideIngestSecret123!"

# --- RAZORPAY CONFIGURATION (OPTIONAL FOR PER-ORDER STANDARD CHECKOUT) ---
# If omitted, system seamlessly redirects students to your existing Razorpay Payment Link (https://rzp.io/rzp/08VeAGUM)
# RAZORPAY_KEY_ID="rzp_live_YourKeyId"
# RAZORPAY_KEY_SECRET="YourRazorpayKeySecret"
# RAZORPAY_WEBHOOK_SECRET="YourWebhookSecret"
